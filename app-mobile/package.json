{
  "name": "vagas-especiais-app",
  "version": "1.0.0",
  "private": true,
  "description": "App Android/iOS do Vagas Especiais Niterói (Capacitor).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "sync": "node scripts/build.mjs && cap sync",
    "android": "node scripts/build.mjs && cap sync android && cap open android",
    "ios": "node scripts/build.mjs && cap sync ios && cap open ios",
    "release": "node scripts/build.mjs --producao && cap sync"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "esbuild": "^0.28.2"
  }
}
